# Public URL for production metadata and PWA links
NEXT_PUBLIC_APP_URL=https://example.com

# Optional media engine overrides (blank uses PATH / platform auto-detection)
YTDLP_PATH=
FFMPEG_PATH=
DENO_PATH=
YTDLP_FORCE_IPV4=true

# Optional temporary processing directory (blank uses the OS temp directory)
TEMP_DIR=

# Supabase temporary storage for non-direct API jobs
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Optional production worker/database configuration
REDIS_URL=
DATABASE_URL=
